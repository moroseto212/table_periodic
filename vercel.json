{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "table-periodic-moroseto\\.vercel\\.app"
        }
      ],
      "destination": "https://periodiclab.web.id/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "table-periodic-moroseto\\.vercel\\.app"
        }
      ],
      "destination": "https://periodiclab.web.id/:path*",
      "permanent": true
    }
  ]
}
